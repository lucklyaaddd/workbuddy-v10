# ========== Supabase 配置 ==========
# 从 Supabase Dashboard → Settings → API 获取
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ========== 服务端密钥（仅在 Vercel Serverless Functions 中使用） ==========
# 从 Supabase Dashboard → Settings → API → service_role 获取
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ========== Bark 推送加密密钥 ==========
# AES-256-GCM 加密密钥，32 字节十六进制字符串（64 个字符）
# 生成方式：openssl rand -hex 32
BARK_ENCRYPTION_KEY=your-64-char-hex-encryption-key

# ========== Vercel Cron 密钥 ==========
# 定时任务接口鉴权密钥，防止未授权调用
CRON_SECRET=your-cron-secret-key

# ========== 导出频率限制 ==========
# 每日最大导出次数
EXPORT_DAILY_LIMIT=3
